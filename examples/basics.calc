# Основы: переменные, формулы, функции, псевдонимы.
# Запуск: calc --file examples/basics.calc

# Переменные и формулы
r = 5
print("Площадь круга R=5:", Pi() * Sqr(r))

# Корень квадратного уравнения x^2 - 5x + 6 = 0
a = 1
b = 0 - 5
c = 6
d = b*b - 4*a*c
print("Корень уравнения:", (0 - b + Sqrt(d)) / (2 * a))

# Сложный процент: 1000 под 5% годовых, 10 лет (деление настоящее: 5/100 = 0.05)
print("Вклад через 10 лет:", Round(1000 * Pow(1.05, 10)))

# Пользовательская функция (тело — одно выражение)
fn celsius(f) = (f - 32) * 5.0 / 9
print("212F в C:", celsius(212))

# Псевдоним встроенной функции (можно кириллицей)
alias корень = Sqrt
print("корень(2):", корень(2))
